# Copia este archivo a .env para correr ReportaCalle en tu computadora.
# En local puedes dejar vacías las variables de Supabase: la app usa
# SQLite (o un JSON) y la carpeta uploads/.

# --- Servidor ---
# Render inyecta PORT solo. En local el valor de abajo basta.
PORT=3000

# Dirección pública de la app, sin barra final.
# Sirve para los enlaces del correo (seguimiento y fotos).
# En local puedes dejarla vacía: se usa el host de la petición.
PUBLIC_BASE_URL=

# --- Administración ---
# Contraseña del panel /admin. Sin ella nadie puede entrar.
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesión. Usa una frase larga y aleatoria.
# En el Blueprint de Render se genera sola.
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# --- Base de datos ---
# Si está vacía, los datos se guardan en local (SQLite o JSON).
# En producción pega aquí la URI de Supabase (incluye ?sslmode=require).
DATABASE_URL=

# Opcional. auto (por defecto) | postgres | sqlite | json
# DATA_BACKEND=auto

# --- Fotos (Supabase Storage) ---
# Si estas tres están vacías, las fotos se guardan en la carpeta uploads/.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=reportes

# --- Correo al municipio (SMTP) ---
# Funciona con Brevo, Resend, u otro SMTP. No uses tu Gmail personal.
# Si las dejas vacías o escribes PENDIENTE, el reporte se queda en
# "Inspeccionado" y puedes reenviar desde el panel cuando estén listas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=atencion.ciudadana@sji.gob.mx

# SOLO para pruebas locales. Escribe "json" para simular un envío exitoso
# sin servidor SMTP (el mensaje se guarda en data/buzon/). Nunca lo pongas
# en Render.
# MAIL_TRANSPORT=json
